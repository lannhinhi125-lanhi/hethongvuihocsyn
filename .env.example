# Local: copy this file to .env.local; paste your Google AI Studio API key.
# Vercel: set these exact names in Project Settings > Environment Variables.
# Server only. Never prefix the Gemini key with VITE_ or paste it into a .ts file.
GEMINI_API_KEY=""
# Choose a generateContent model available to your API key; this is configurable.
GEMINI_MODEL="gemini-3.5-flash"

# SUPABASE CONFIGURATION:
# Lấy từ Supabase Dashboard: Project Settings -> API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

